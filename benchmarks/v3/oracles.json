      {
        "args": [
          1,
          3,
          2
        ],
        "exception": "ValueError"
      }
    ]
  },
  "py-config": {
    "cases": [
      {
        "args": [
          {
            "enabled": "false"
          }
        ],
        "expected": false
      },
      {
        "args": [
          {
            "enabled": " YES "
          }
        ],
        "expected": true
      },
      {
        "args": [
          {}
        ],
        "expected": false
      },
      {
        "args": [
          {
            "enabled": "0"
          }
        ],
        "expected": false
      },
      {
        "args": [
          {
            "enabled": "perhaps"
          }
        ],
        "exception": "ValueError"
      },
      {
        "args": [
          "true"
        ],
        "entry": "parser.parse_bool",
        "expected": true
      },
      {
        "args": [
          " no "
        ],
        "entry": "parser.parse_bool",
        "expected": false
      },
      {
        "args": [
          "1"
        ],
        "entry": "parser.parse_bool",
        "expected": true
      },
      {
        "args": [
          "FALSE"
        ],
        "entry": "parser.parse_bool",
        "expected": false
      }
    ]
  },
